{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "twee3",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_leading_newlines"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "passage"
          }
        }
      ]
    },
    "_leading_newlines": {
      "type": "REPEAT1",
      "content": {
        "type": "STRING",
        "value": "\n"
      }
    },
    "passage": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "passage_header"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "passage_content"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "passage_header": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "::"
          },
          {
            "type": "SYMBOL",
            "name": "passage_name"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "tags"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "metadata"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "passage_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "(?:[^\\[\\{\\n\\\\]|\\\\.)+"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]*"
        }
      ]
    },
    "tags": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "tag_list"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "]"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]*"
          }
        ]
      }
    },
    "tag_list": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "tag"
          },
          {
            "type": "PATTERN",
            "value": "\\s+"
          }
        ]
      }
    },
    "tag": {
      "type": "PATTERN",
      "value": "(?:[^\\]\\s\\\\]|\\\\.)+"
    },
    "metadata": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{"
          },
          {
            "type": "SYMBOL",
            "name": "json_metadata"
          },
          {
            "type": "STRING",
            "value": "}"
          }
        ]
      }
    },
    "json_metadata": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\"(?:[^\"\\\\]|\\\\.)*\""
          },
          {
            "type": "PATTERN",
            "value": "[^\"}]+"
          }
        ]
      }
    },
    "passage_content": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "text"
          },
          {
            "type": "SYMBOL",
            "name": "macro"
          },
          {
            "type": "SYMBOL",
            "name": "link"
          }
        ]
      }
    },
    "text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^<\\[:{\\n]+"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "macro": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<<"
        },
        {
          "type": "SYMBOL",
          "name": "macro_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "macro_arg"
          }
        },
        {
          "type": "STRING",
          "value": ">>"
        }
      ]
    },
    "macro_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-\\/]+"
    },
    "macro_arg": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "SYMBOL",
          "name": "attribute"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "boolean"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "}"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "PATTERN",
          "value": "[^\\s\"'=,\\[\\]{}<>:]+"
        }
      ]
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "PATTERN",
              "value": "[^\"]*"
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "PATTERN",
              "value": "[^']*"
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "variable": {
      "type": "PATTERN",
      "value": "\\$[a-zA-Z0-9_]+"
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        },
        {
          "type": "STRING",
          "value": "="
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+(?:\\.\\d+)?"
    },
    "boolean": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "link": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "[["
        },
        {
          "type": "SYMBOL",
          "name": "link_text"
        },
        {
          "type": "STRING",
          "value": "]]"
        }
      ]
    },
    "link_text": {
      "type": "PATTERN",
      "value": "(?:[^\\]]|\\][^\\]])+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]+"
    }
  ],
  "conflicts": [
    [
      "passage_header"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}